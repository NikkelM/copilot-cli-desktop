# Line endings are normalised to LF in the repository and checked out as the platform
# expects. Without this the answer depends on each contributor's core.autocrlf, which is why
# the working tree here ended up mixed and git narrated a warning on almost every commit.
* text=auto

# Diffing a lockfile by hand is never the point, and collapsing them keeps a dependency bump
# readable.
package-lock.json linguist-generated=true -diff
src-tauri/Cargo.lock linguist-generated=true -diff

# Binary, so git should not try to merge or diff them as text.
*.png binary
*.ico binary
*.icns binary
