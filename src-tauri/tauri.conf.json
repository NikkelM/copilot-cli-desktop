{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copilot CLI Desktop",
  "version": "0.1.2-beta.1",
  "identifier": "com.nikkelm.copilot-cli-desktop",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run bundle:sidecar && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:sidecar && npm run bundle:sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Copilot CLI Desktop",
        "width": 1280,
        "height": 840,
        "minWidth": 780,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "sidecar-bundle": "sidecar"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "version": "0.1.2.1"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyQ0FENjEyMDRCQkVFNjMKUldSajdyc0VFdGJLZ25wNTFHQ2VwbC9ONktFZzlRR3dWS2hUTFlaYlNja2RLOVNNVGdLZXlPYm4K",
      "endpoints": [
        "https://github.com/NikkelM/copilot-cli-desktop/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
